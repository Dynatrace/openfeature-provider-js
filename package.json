    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.1.1",
    "shx": "^0.4.0",
