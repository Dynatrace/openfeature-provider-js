{
  "name": "@dynatrace/openfeature-provider-node",
  "version": "0.1.0-alpha",
  "description": "The official Dynatrace OpenFeature provider for Node.js (server-side).",
  "main": "./dist/cjs/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "types": "./dist/types.d.ts",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "OpenFeature",
    "Dynatrace",
    "feature-flags",
    "feature",
    "flags",
    "toggles",
    "experimentation",
    "flagd"
  ],
  "homepage": "https://github.com/Dynatrace/openfeature-provider-js/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/Dynatrace/openfeature-provider-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynatrace/openfeature-provider-js.git",
    "directory": "packages/node"
  },
  "license": "Apache-2.0",
  "author": "Dynatrace",
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:esm": "esbuild src/index.ts --bundle --sourcemap --target=node20 --platform=node --format=esm --external:@openfeature/server-sdk --external:@openfeature/flagd-core --external:@openfeature/core --outfile=./dist/esm/index.js",
    "build:cjs": "esbuild src/index.ts --bundle --sourcemap --target=node20 --platform=node --format=cjs --external:@openfeature/server-sdk --external:@openfeature/flagd-core --external:@openfeature/core --outfile=./dist/cjs/index.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:rollup-types": "rollup -c rollup.config.mjs && shx rm -rf ./dist/types/node ./dist/types/shared",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types && npm run build:rollup-types",
    "postbuild": "shx cp ../../package.esm.json ./dist/esm/package.json && shx cp ../../package.cjs.json ./dist/cjs/package.json",
    "test": "vitest run",
    "test:e2e": "git -C ../.. submodule update --init fm-provider-test-harness && vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@openfeature/flagd-core": "^4.0.0"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.17.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module"
}
