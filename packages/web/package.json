{
  "name": "@dynatrace/openfeature-provider-web",
  "version": "0.2.2-alpha",
  "description": "The official Dynatrace OpenFeature provider for web.",
  "main": "./dist/cjs/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "types": "./dist/types.d.ts",
  "keywords": [
    "OpenFeature",
    "Dynatrace",
    "feature-flags",
    "feature",
    "flags",
    "toggles",
    "experimentation",
    "OFREP",
    "flagd"
  ],
  "homepage": "https://github.com/Dynatrace/openfeature-provider-js/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/Dynatrace/openfeature-provider-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynatrace/openfeature-provider-js.git",
    "directory": "packages/web"
  },
  "license": "Apache-2.0",
  "author": "Dynatrace",
  "scripts": {
    "clean": "shx rm -rf ./dist",
    "build:version": "node -e \"const v=require('./package.json').version;const fs=require('fs');fs.writeFileSync('src/version.ts','// Auto-generated by npm run build:version — do not edit by hand.\\nexport const PACKAGE_VERSION = \\'' + v + '\\';\\n')\"",
    "build:esm": "esbuild src/index.ts --bundle --sourcemap --target=es2015 --platform=browser --format=esm --external:@openfeature/web-sdk --external:@openfeature/ofrep-web-provider --outfile=./dist/esm/index.js",
    "build:cjs": "esbuild src/index.ts --bundle --sourcemap --target=es2015 --platform=browser --format=cjs --external:@openfeature/web-sdk --external:@openfeature/ofrep-web-provider --outfile=./dist/cjs/index.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:rollup-types": "rollup -c ../../rollup.config.mjs",
    "build": "npm run clean && npm run build:version && npm run build:esm && npm run build:cjs && npm run build:types && npm run build:rollup-types",
    "postbuild": "shx cp ../../package.esm.json ./dist/esm/package.json && shx cp ../../package.cjs.json ./dist/cjs/package.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@openfeature/ofrep-web-provider": "^0.3.6"
  },
  "peerDependencies": {
    "@openfeature/web-sdk": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module"
}
